{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "shell_integration": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "darkGray",
          "template": "╭─"
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "black",
          "background": "green",
          "template": " {{ .Path }}",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "magenta",
          "template": "  {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }} <yellow></>{{ end }}{{ if gt .Ahead 0 }} ⇡{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }}"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "yellow",
          "template": "   {{ .FormattedMs }}",
          "options": {
            "threshold": 2000,
            "style": "round"
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "red",
          "template": "   {{ .Code }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "filler": "<darkGray,transparent>─</>",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "cyan",
          "template": "  {{ .UserName }}{{ if .SSHSession }}@{{ .HostName }}{{ end }} "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "darkGray",
          "template": " {{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04:05"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "darkGray",
          "template": "╰─"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}red{{ end }}"
          ],
          "template": "❯"
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "green",
    "background": "transparent",
    "foreground_templates": [
      "{{ if gt .Code 0 }}red{{ end }}"
    ],
    "template": "<green,transparent></><black,green>{{ .Folder }}</><green,transparent></> ❯ "
  }
}
